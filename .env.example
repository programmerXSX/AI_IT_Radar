# =============================================================================
# AI IT Radar — example configuration. Copy to `.env` and fill in.
# =============================================================================

# -----------------------------------------------------------------------------
# Convention SDK env vars (read by various SDKs even without RADAR_* aliases).
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

DASHSCOPE_API_KEY=

# Reserved for future Tavily-based web search source.
TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# Main scoring LLM (RECOMMENDED: DeepSeek for cost-efficiency).
# Any OpenAI-compatible endpoint works (DeepSeek, OpenAI, vLLM, Ollama 0.4+).
# -----------------------------------------------------------------------------
RADAR_LLM__PROVIDER=openai
RADAR_LLM__MODEL=deepseek-chat
RADAR_LLM__BASE_URL=https://api.deepseek.com/v1
RADAR_LLM__API_KEY=

# -----------------------------------------------------------------------------
# Critic LLM (RECOMMENDED: a different model family from the main scorer).
# Qwen via DashScope's OpenAI-compatible mode is a good pairing with DeepSeek.
# -----------------------------------------------------------------------------
RADAR_CRITIC__PROVIDER=openai
RADAR_CRITIC__MODEL=qwen-plus
RADAR_CRITIC__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RADAR_CRITIC__API_KEY=

# -----------------------------------------------------------------------------
# Embedding model. Three providers supported:
#   local      — sentence-transformers (no API; ~2.3GB on first download).
#   dashscope  — Tongyi DashScope native SDK; default model text-embedding-v3.
#   openai     — Any OpenAI-compatible /embeddings endpoint.
# When provider=dashscope and api_key is empty, the SDK picks DASHSCOPE_API_KEY.
# -----------------------------------------------------------------------------
RADAR_EMBEDDING__PROVIDER=dashscope
RADAR_EMBEDDING__MODEL=text-embedding-v3
RADAR_EMBEDDING__API_KEY=

# -----------------------------------------------------------------------------
# Optional: GitHub PAT to lift Search API rate limit (no scopes required).
# -----------------------------------------------------------------------------
RADAR_GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Storage layout (SQLite + ChromaDB live under this directory).
# -----------------------------------------------------------------------------
RADAR_DATA_DIR=./data
