<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>AI IT Radar — {{ report.generated_at.strftime("%Y-%m-%d") }}</title>
<style>
  :root {
    --bg: #0f1115; --card: #161a22; --text: #e6e8eb; --muted: #8a93a6;
    --accent: #6ea8fe; --watch: #f0c36d; --strong: #5fc28a; --mon: #5b6276;
    --danger: #d97a82;
  }
  body { background:var(--bg); color:var(--text); font-family:system-ui, sans-serif; margin:0; padding:24px; line-height:1.5; }
  header { display:flex; align-items:baseline; gap:12px; flex-wrap:wrap; margin-bottom:24px; }
  header h1 { margin:0; font-size:24px; }
  header .meta { color:var(--muted); }
  .summary { display:flex; gap:12px; margin-bottom:32px; }
  .summary .pill { background:var(--card); padding:8px 14px; border-radius:6px; }
  .pill.strong { border-left:3px solid var(--strong); }
  .pill.watch  { border-left:3px solid var(--watch); }
  .pill.monitor{ border-left:3px solid var(--mon); }
  section.band { margin-bottom:40px; }
  section.band > h2 { border-bottom:1px solid #2a2f3a; padding-bottom:8px; }
  article.item { background:var(--card); border-radius:8px; padding:16px 18px; margin:16px 0; }
  article.item h3 { margin:0 0 6px 0; font-size:18px; }
  article.item h3 a { color:var(--accent); text-decoration:none; }
  .meta-line { color:var(--muted); font-size:13px; margin-bottom:8px; }
  .agg { font-weight:600; }
  .agg.strong { color:var(--strong); }
  .agg.watch  { color:var(--watch); }
  .agg.monitor{ color:var(--mon); }
  .needs-human { color:var(--danger); margin-left:8px; font-weight:500; }
  table.dims { border-collapse:collapse; width:100%; margin:8px 0; font-size:13px; }
  table.dims th, table.dims td { border-bottom:1px solid #2a2f3a; padding:6px 8px; text-align:left; }
  table.dims th { color:var(--muted); font-weight:500; }
  details { margin-top:8px; }
  details summary { cursor:pointer; color:var(--muted); }
  .feedback { margin-top:12px; display:flex; gap:8px; }
  .feedback button {
    border:none; padding:6px 12px; border-radius:4px; cursor:pointer; font-size:13px; color:#0f1115; font-weight:600;
  }
  .feedback button.adopt  { background:var(--strong); }
  .feedback button.watch  { background:var(--watch); }
  .feedback button.ignore { background:var(--mon); color:#e6e8eb; }
  .feedback .ack { color:var(--muted); font-size:12px; align-self:center; }
  ul.caps { margin:6px 0; padding-left:20px; }
  ul.caps li { margin-bottom:2px; }
  .quote { color:var(--muted); font-style:italic; font-size:12px; }
  .quote a.src { color:var(--accent); font-style:normal; margin-left:6px; text-decoration:none; }
  .quote a.src:hover { text-decoration:underline; }
  .banner {
    background:#3a2f1a; border-left:3px solid var(--watch); color:#f5deb3;
    padding:10px 14px; border-radius:6px; margin-bottom:18px; font-size:14px;
  }
  .banner code { background:#1a1d24; padding:2px 6px; border-radius:3px; }
  .banner a { color:var(--accent); }
</style>
</head>
<body>
<header>
  <h1>AI IT Radar</h1>
  <span class="meta">
    {{ report.period_start.strftime("%Y-%m-%d") }} → {{ report.period_end.strftime("%Y-%m-%d") }}
    · generated {{ report.generated_at.strftime("%Y-%m-%d %H:%M UTC") }}
  </span>
</header>

<div id="file-protocol-banner" class="banner" hidden>
  当前以本地文件方式打开（<code>file://</code>），反馈按钮无法持久化。
  请在终端运行 <code>uv run radar feedback-server</code>，然后访问
  <a href="http://127.0.0.1:8765/latest">http://127.0.0.1:8765/latest</a> 重新打开本报告。
</div>

<div id="server-status-banner" class="banner" hidden></div>

<div class="summary">
  <div class="pill strong">Strong Recommend: {{ report.strong_recommend | length }}</div>
  <div class="pill watch">Watch: {{ report.watch | length }}</div>
  <div class="pill monitor">Monitor: {{ report.monitor | length }}</div>
</div>

{% macro render_item(it) %}
  {% set s = it.score %}
  {% set band = s.band if s else 'monitor' %}
  <article class="item" data-uid="{{ it.candidate.uid }}">
    <h3><a href="{{ it.candidate.url }}" target="_blank" rel="noopener">{{ it.candidate.title }}</a></h3>
    <div class="meta-line">
      {{ it.candidate.source.value }} / {{ it.candidate.kind.value }}
      {% if s %} ·
        <span class="agg {{ band }}">aggregate {{ "%.2f"|format(s.aggregate) }} / 5.00</span>
        {% if s.needs_human %}<span class="needs-human">[needs human review]</span>{% endif %}
      {% endif %}
    </div>

    {% if it.analysis and it.analysis.method_summary %}
      <p>{{ it.analysis.method_summary }}</p>
    {% endif %}

    {% if it.analysis and it.analysis.key_capabilities %}
      <ul class="caps">
        {% for k in it.analysis.key_capabilities %}<li>{{ k }}</li>{% endfor %}
      </ul>
    {% endif %}

    {% if s and s.dimensions %}
    <details>
      <summary>Per-dimension scores</summary>
      <table class="dims">
        <thead><tr><th>Dimension</th><th>Score</th><th>Confidence</th><th>Rationale</th></tr></thead>
        <tbody>
        {% for d in s.dimensions %}
          <tr>
            <td>{{ d.dimension_id }}</td>
            <td>{{ d.score }}</td>
            <td>{{ "%.2f"|format(d.confidence) }}</td>
            <td>
              {{ d.rationale }}
              {% if d.quote %}
              <div class="quote">
                &ldquo;{{ d.quote }}&rdquo;
                <a class="src" href="{{ it.candidate.url }}" target="_blank" rel="noopener">[来源]</a>
              </div>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </details>
    {% endif %}

    <div class="feedback">
      <button class="adopt"  data-tag="adopt">Adopt</button>
      <button class="watch"  data-tag="watch">Watch</button>
      <button class="ignore" data-tag="ignore">Ignore</button>
      <span class="ack" data-ack></span>
    </div>
  </article>
{% endmacro %}

<section class="band">
  <h2>Strong Recommend</h2>
  {% if report.strong_recommend %}
    {% for it in report.strong_recommend %}{{ render_item(it) }}{% endfor %}
  {% else %}<p><em>No items.</em></p>{% endif %}
</section>

<section class="band">
  <h2>Watch</h2>
  {% if report.watch %}
    {% for it in report.watch %}{{ render_item(it) }}{% endfor %}
  {% else %}<p><em>No items.</em></p>{% endif %}
</section>

<section class="band">
  <h2>Monitor</h2>
  {% if report.monitor %}
    {% for it in report.monitor %}{{ render_item(it) }}{% endfor %}
  {% else %}<p><em>No items.</em></p>{% endif %}
</section>

<script>
  // Resolve the feedback API base URL.
  // - When the report is served by the feedback-server itself (preferred path),
  //   we use a same-origin relative URL ("/feedback") — works with any host/port.
  // - When opened as file:// (double-click), we cannot reach loopback HTTP from
  //   most browsers due to mixed-content/file-origin rules — show a banner.
  // - An ?api=http://host:port query param overrides for cross-origin debugging.
  const apiOverride = new URLSearchParams(location.search).get("api");
  const isFile = location.protocol === "file:";
  const FEEDBACK_BASE = apiOverride || (isFile ? "http://127.0.0.1:8765" : "");

  if (isFile && !apiOverride) {
    document.getElementById("file-protocol-banner").hidden = false;
  }

  // Probe the feedback server health on load so users get an early warning
  // if it isn't running, before they click 12 buttons in vain.
  (async () => {
    const banner = document.getElementById("server-status-banner");
    try {
      const r = await fetch(FEEDBACK_BASE + "/", { method: "GET" });
      if (!r.ok) throw new Error("status " + r.status);
    } catch (e) {
      if (!isFile) {
        banner.hidden = false;
        banner.innerHTML = "反馈服务似乎未启动 (<code>" +
          (FEEDBACK_BASE || location.origin) +
          "</code> 不可达)。请运行 <code>uv run radar feedback-server</code>。";
      }
    }
  })();

  document.querySelectorAll("article.item").forEach((art) => {
    const uid = art.dataset.uid;
    art.querySelectorAll(".feedback button").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const tag = btn.dataset.tag;
        const ack = art.querySelector("[data-ack]");
        ack.textContent = "saving...";
        try {
          const r = await fetch(FEEDBACK_BASE + "/feedback", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ candidate_uid: uid, tag, user: "decision-maker" }),
          });
          if (r.ok) {
            ack.textContent = "已记录: " + tag;
            ack.style.color = "#5fc28a";
          } else {
            ack.textContent = "失败 HTTP " + r.status;
            ack.style.color = "#d97a82";
          }
        } catch (e) {
          ack.textContent = isFile
            ? "请先访问 http://127.0.0.1:8765/latest"
            : "feedback-server 未启动 / 网络错误";
          ack.style.color = "#d97a82";
        }
      });
    });
  });
</script>
</body>
</html>
